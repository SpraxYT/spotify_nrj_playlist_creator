# 158 = NRJ FM, 1 = NRJ HITS
NRJ_WEBRADIO_ID=158
# Optionnel — URL flux ICY (défaut selon webradio)
# NRJ_STREAM_URL=

# Boucle locale (secondes)
POLL_INTERVAL_SECONDS=45
